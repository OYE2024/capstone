# Локальний набір даних; не додавати до репозиторію.
/datasets/data.csv

# Зберігати папку outputs, але не додавати її результати.
/outputs/*
!/outputs/.gitkeep

# Зберігати папку temp, але ігнорувати її тимчасовий вміст.
/temp/*
!/temp/.gitkeep

# Зберігати папку audit, але ігнорувати файли з результатами аудиту.
/audit/*
!/audit/.gitkeep

# Документація не додається до репозиторію.
/documents/

# Локальне віртуальне середовище Python.
/.venv/

# Локальні інструкції агента.
/AGENT.MD
